# Neon (pooled connection string)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth (login Google — Auth.js v5)
AUTH_SECRET=genera-uno-con-openssl-rand-base64-32
AUTH_GOOGLE_ID=...apps.googleusercontent.com
AUTH_GOOGLE_SECRET=...

# ── Correo ────────────────────────────────────────────────────────────────────
# Transporte: gmail (API de Google Workspace, recomendado) o resend. Si no se pone nada,
# se usa gmail cuando hay cuenta de servicio configurada y resend en caso contrario.
EMAIL_TRANSPORTE=gmail
# Excepción por módulo (perfiles: LICENCIAS, SALIDAS, ABC, EVALUACIONES, GENERAL)
# EMAIL_TRANSPORTE_LICENCIAS=resend

# Remitente por módulo. Con Gmail, el correo sale del buzón REAL del dominio (aparece en sus
# "Enviados" y las respuestas llegan allí), así que tiene que existir y estar delegado.
EMAIL_FROM_LICENCIAS="Licencias · Colegio Consolación <licencias@consolacionburriana.com>"
EMAIL_FROM_GENERAL="Colegio Consolación <no-responder@consolacionburriana.com>"
# A dónde contestan las familias. Licencias centraliza en su buzón; en Salidas y Evaluaciones
# el Reply-To lo pone en cada envío quien lo manda (el tutor / el gestor), no hace falta var.
EMAIL_REPLYTO_LICENCIAS=licencias@consolacionburriana.com
# Solo si el From es un alias o un grupo: buzón real que se suplanta por delegación de dominio
# EMAIL_BUZON_LICENCIAS=secretaria@consolacionburriana.com
# Correos/segundo por buzón en los masivos por Gmail (cuota real ≈ 2,5/s). Por defecto 3.
# GMAIL_CONCURRENCIA=3

# Resend (transporte alternativo / de respaldo)
RESEND_API_KEY=re_...
RESEND_FROM="Colegio Consolación <no-responder@consolacionburriana.com>"

# Lista de correos de aviso de Licencias (separados por coma)
LICENCIAS_GESTORES=persona1@consolacionburriana.com,persona2@consolacionburriana.com

# Cuenta de servicio de Google. La MISMA sirve para el Sheet de Licencias y para enviar
# correo por la API de Gmail (hace falta delegación de dominio con el scope gmail.send).
# Alias nuevos y preferidos: GOOGLE_SA_CLIENT_EMAIL / GOOGLE_SA_PRIVATE_KEY.
GOOGLE_SHEETS_CLIENT_EMAIL=...@....iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=...

# URL pública para TODOS los enlaces que salen por correo (magic links, avisos, botones
# de los templates). ES EL SITIO donde cambiar el dominio: en Vercel (Settings → Environment
# Variables), NUNCA en el código. Mientras el dominio definitivo no esté enganchado, aquí va
# la URL de Vercel que toque (https://consolacionburriana-tools1.vercel.app); el día que
# tools.consolacionburriana.com esté listo, se cambia este valor y se redeploya — ni una
# línea de código que tocar. Si no está fijada, el código cae a tools.consolacionburriana.com
# (ver appBaseUrl() en src/lib/constants.ts). En local, http://localhost:3000.
APP_BASE_URL=http://localhost:3000

# Vercel Blob (justificantes de Salidas)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Puntualidad ───────────────────────────────────────────────────────────────
# Correos que reciben COPIA del aviso del tercer retraso (jefatura/dirección).
# Separados por comas. Vacío = solo el tutor/a de la clase.
PUNTUALIDAD_AVISOS_COPIA=

# Secreto del cron de Vercel que manda el resumen semanal a tutores (viernes 17:00
# hora local / 15:00 UTC, ver vercel.json). En Vercel se genera solo al añadir el cron;
# en local no hace falta: con sesión del módulo se puede lanzar a mano.
CRON_SECRET=

# AUTOASM · cifrado de la contraseña del FTP de Apple School Manager (opcional).
# Si no se pone, se deriva de AUTH_SECRET, que ya es obligatorio: solo hace falta si algún
# día se quiere rotar el secreto del login sin invalidar lo guardado en asm_ftp_config.
AUTOASM_CRYPTO_KEY=
